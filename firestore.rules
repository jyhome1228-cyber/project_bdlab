rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'jyhome1228@gmail.com';
    }

    match /bdlabClientRequests/{requestId} {
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.company is string
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.purpose is string;
      allow read, update, delete: if isAdmin();
    }

    match /bdlabAccess/{accessHash} {
      // Access codes are SHA-256 document IDs. Clients can request one exact
      // document by a code they already possess, but cannot enumerate the list.
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }
  }
}
