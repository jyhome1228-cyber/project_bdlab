rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'jyhome1228@gmail.com';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    match /bdlabClientProfiles/{uid} {
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.clientId is string
        && request.resource.data.company is string
        && request.resource.data.name is string
        && request.resource.data.email is string;

      allow get: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow list: if isAdmin();

      allow update: if isAdmin() || (
        isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.clientId == resource.data.clientId
      );

      allow delete: if isAdmin();
    }

    match /bdlabClientRequests/{requestId} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'registered'
        && request.resource.data.clientId is string
        && request.resource.data.company is string
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.purpose is string;

      allow read: if isAdmin() || (
        isSignedIn()
        && resource.data.uid == request.auth.uid
      );

      allow update, delete: if isAdmin();
    }

    /* Legacy approval-code collection retained for backwards compatibility. */
    match /bdlabAccess/{accessHash} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }
  }
}
